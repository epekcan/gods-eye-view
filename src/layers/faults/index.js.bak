import * as Cesium from 'cesium';

// Türkiye Diri Fay Hatları Vektör Verisi
const TURKEY_FAULTS_GEOJSON_URL =
  'https://raw.githubusercontent.com/alpers/Turkey-Earthquake-Hazard-Map/master/data/faults.geojson';

export function createMtaFaultsLayer() {
  let _viewer = null;
  let _dataSource = null;
  let _enabled = false;
  let _count = 0;
  let _error = null;

  return {
    id: 'mta-faults',
    name: 'Diri Fay Hatları',
    label: 'Diri Fay Hatları',
    icon: '⚡',
    source: 'MTA / Açık Jeoloji',
    showInTogglePanel: true,
    updateInterval: 0,

    async init(viewer) {
      _viewer = viewer;
      try {
        // clampToGround: false vererek arazi (terrain) 429 limitini tamamen engelliyoruz
        _dataSource = await Cesium.GeoJsonDataSource.load(TURKEY_FAULTS_GEOJSON_URL, {
          clampToGround: false,
        });

        const entities = _dataSource.entities.values;
        _count = entities.length;

        for (const entity of entities) {
          if (entity.polyline) {
            entity.polyline.clampToGround = false;
            entity.polyline.width = 2.5;
            // Parlayan kırmızı fay çizgisi
            entity.polyline.material = new Cesium.PolylineGlowMaterialProperty({
              glowPower: 0.2,
              taperPower: 1.0,
              color: Cesium.Color.fromCssColorString('#ff2222'),
            });
            // Küre üzerinde arazinin altında kaybolmaması için elipsoide yakın irtifada tut
            entity.polyline.arcType = Cesium.ArcType.GEODESIC;
          }
        }

        _dataSource.show = false;
        await viewer.dataSources.add(_dataSource);
        console.log(`[Data:Faults] Loaded ${_count} fault segments.`);
      } catch (err) {
        console.warn('[Data:Faults] Fay hatları yüklenemedi:', err);
        _error = err?.message || 'Fay verisi alınamadı';
      }
      return true;
    },

    async enable(viewer) {
      _enabled = true;
      if (viewer && !_viewer) _viewer = viewer;
      if (_dataSource) {
        _dataSource.show = true;
      }
      return true;
    },

    async disable(viewer) {
      _enabled = false;
      if (_dataSource) {
        _dataSource.show = false;
      }
      return true;
    },

    async update() {
      return true;
    },

    getStats() {
      return {
        count: _count > 0 ? _count : (_enabled ? 'AKTİF' : 0),
        countLabel: 'SEGMENT',
        status: _enabled ? 'nominal' : 'offline',
        source: 'MTA',
        lastUpdate: _enabled ? Date.now() : null,
      };
    },

    async destroy(viewer = _viewer) {
      _enabled = false;
      if (_dataSource && viewer) {
        try {
          viewer.dataSources.remove(_dataSource, true);
        } catch (_) {}
        _dataSource = null;
      }
      _viewer = null;
      return true;
    },
  };
}