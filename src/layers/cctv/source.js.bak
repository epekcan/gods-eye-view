function frameUrlFor(camera, refreshMs = ACTIVE_FRAME_REFRESH_MS) {
  const feed = SAMPLE_FEEDS[(camera.feedIndex || 0) % SAMPLE_FEEDS.length];
  const cadenceMs = Math.max(1000, safeNumber(refreshMs, ACTIVE_FRAME_REFRESH_MS));
  const tick = Math.floor(Date.now() / cadenceMs);
  return `${feed}&t=${tick}`;
}

function mediaUrlFor(camera) {
  return frameUrlFor(camera, 15000);
}

/** Supply catalog/health records for Turkish Traffic & City Nodes. */
export function createCctvSource({
  fetchImpl = (...args) => globalThis.fetch(...args),
} = {}) {
  return {
    async getCatalog() {
      // Doğrudan Türkiye kameralarını dönüyoruz (Austin API'sini bypass ettik)
      return {
        sources: TURKEY_CAMERAS.map((cam) => ({
          id: cam.id,
          name: cam.name,
          city: cam.city,
          lat: cam.lat,
          lon: cam.lon,
          headingDeg: cam.headingDeg,
          fovDeg: cam.fovDeg,
          pitchDeg: cam.pitchDeg,
          rangeM: 200,
          aspectRatio: 1.77,
          feedIndex: cam.feedIndex,
        })),
      };
    },

    async getHealth() {
      return {
        cameras: TURKEY_CAMERAS.map((cam) => ({
          id: cam.id,
          status: cam.status,
          lastSeen: Date.now(),
        })),
      };
    },

    getFrameUrl: frameUrlFor,
    getMediaUrl: mediaUrlFor,
  };
}