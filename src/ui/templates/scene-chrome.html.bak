<div id="cesiumContainer"></div>
  <div id="world-overlay-root" aria-hidden="true">
    <canvas id="world-overlay-canvas"></canvas>
  </div>
  <div id="world-overlay-actions" class="world-overlay-accessibility" role="region" aria-label="Görünür harita hedefleri">
    <div id="world-overlay-action-list"></div>
    <div id="world-overlay-status" role="status" aria-live="polite" aria-atomic="true"></div>
  </div>

  <!-- Title -->
  <div id="title-bar">
    <div class="title-glow"></div>
    <h1><span class="title-logo brand-logo" data-logo-gaze data-logo-src="/logo.svg" aria-hidden="true"><img src="/logo.svg" alt="" /></span> <span>TARGIL <span class="title-accent">IRS</span></span></h1>
    <p class="subtitle">AÇIK KAYNAK SAHA GÖZLEM PLATFORMU</p>
  </div>

  <!-- Style indicator -->
  <div id="style-indicator">
    <span class="indicator-label">AKTİF MOD</span>
    <span class="indicator-value" id="active-style-name">STANDART</span>
  </div>

  <!-- Top-center camera and share actions -->
  <nav id="top-center-actions" aria-label="Küre aksiyonları">
    <button id="clear-selected-layers" type="button" aria-label="Seçili katmanları temizle" title="Tüm aktif katmanları kapat">
      <span class="material-symbols-outlined" aria-hidden="true">layers_clear</span>
    </button>
    <button id="share-btn" type="button" aria-label="Paylaşım bağlantısını kopyala" title="Bağlantıyı kopyala">
      <span class="share-icon" aria-hidden="true">&#x1F517;</span>
    </button>
    <button id="reset-globe-view" type="button" aria-label="Görünümü sıfırla" title="Kamerayı sıfırla ve tüm küreye dön">
      <span class="material-symbols-outlined" aria-hidden="true">public</span>
    </button>
  </nav>
  <div id="global-loading-status" role="status" aria-live="polite" aria-atomic="true" hidden>
    <span id="global-loading-label">CANLI VERİLER YÜKLENİYOR</span>
    <span id="global-loading-detail"></span>
  </div>
  <div id="traffic-sync-chip" aria-live="polite">
    <span id="traffic-sync-label">kara yolu ağı eşitleniyor</span>
    <span id="traffic-sync-progress">0%</span>
  </div>
  <div id="cctv-sync-chip" aria-live="polite">
    <span id="cctv-sync-label">kamera kareleri yükleniyor</span>
    <span id="cctv-sync-progress">0/0</span>
  </div>

  <!-- Toast notification -->
  <div id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Safe frame guides for recording composition -->
  <div id="safe-frame-overlay">
    <div id="safe-frame-box"></div>
  </div>