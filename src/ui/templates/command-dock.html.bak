<!-- Unified bottom command dock: locations, voice (injected at runtime), visual presets -->
  <div id="command-dock" aria-label="Navigasyon, sesli komut ve görsel filtre kontrolleri">
  <!-- Control panel -->
  <div id="control-panel" class="panel-collapsible collapsed">
    <div class="panel-glow"></div>
    <div class="panel-inner">
      <button id="control-panel-toggle" class="panel-header dock-tray-toggle" type="button"
        data-dock-toggle-target="control-panel" aria-expanded="false"
        aria-controls="control-panel-popover" aria-label="Görsel Filtreleri Genişlet">
        <span class="panel-title"><span class="dock-label-icon dock-label-icon-presets" aria-hidden="true"></span>GÖRSEL MODLAR</span>
        <span class="panel-divider"></span>
      </button>
      <div id="control-panel-popover" class="dock-popover-content">
      <button class="dock-pin-btn" data-pin-target="control-panel" type="button" aria-label="Görsel modları sabitle" aria-pressed="false" title="Görsel modlar panelini açık tut"><img src="/pin.svg" alt="" /></button>
      <div id="style-buttons" class="button-grid">
        <button class="style-btn active" data-style="normal" title="Filtresiz standart uydu görüntüsü.">
          <span class="btn-icon">◯</span>
          <span class="btn-label">Standart</span>
          <span class="btn-key">1</span>
        </button>
        <button class="style-btn" data-style="retro" title="Yeşil fosforlu radar ve tarama çizgili CRT ekran simülasyonu.">
          <span class="btn-icon">▦</span>
          <span class="btn-label">CRT Radar</span>
          <span class="btn-key">2</span>
        </button>
        <button class="style-btn" data-style="surveillance" title="Yeşil ışık yoğunlaştırıcı askeri gece görüş gözlüğü modu (NVG).">
          <span class="btn-icon">🌙</span>
          <span class="btn-label">Gece Görüşü</span>
          <span class="btn-key">3</span>
        </button>
        <button class="style-btn" data-style="thermal" title="FLIR termal ısı kontrastı ve kızılötesi tarama modu.">
          <span class="btn-icon">🌡️</span>
          <span class="btn-label">Termal (FLIR)</span>
          <span class="btn-key">4</span>
        </button>
        <button class="style-btn" data-style="anime" title="Çizgisel ve yüksek kontrastlı stilize görünüm.">
          <span class="btn-icon">✦</span>
          <span class="btn-label">Anime</span>
          <span class="btn-key">5</span>
        </button>
        <button class="style-btn" data-style="noir" title="Yüksek kontrastlı siyah-beyaz filtresi.">
          <span class="btn-icon">◐</span>
          <span class="btn-label">Monokrom</span>
          <span class="btn-key">6</span>
        </button>
        <button class="style-btn" data-style="snow" title="Soğuk ve karlı kış iklimi filtrelemesi.">
          <span class="btn-icon">❄</span>
          <span class="btn-label">Kar Modu</span>
          <span class="btn-key">7</span>
        </button>
      </div>
      <section class="map-source-section" aria-labelledby="map-source-label">
        <div class="map-source-heading">
          <span id="map-source-label">HARİTA KAYNAĞI</span>
          <span id="map-stack-status" class="pp-stack-status" aria-live="polite">3D</span>
        </div>
        <div id="map-stack-chips" class="map-stack-chip-row" role="group" aria-label="Harita kaynağı"></div>
      </section>
      </div>
      <div id="style-mini-status" class="panel-mini-status" aria-live="polite">
        <span class="panel-mini-label">Mod</span>
        <span id="style-mini-value" class="panel-mini-value">STANDART</span>
      </div>
    </div>
  </div>

  <!-- Location bar -->
  <div id="location-bar" class="panel-collapsible collapsed">
    <div class="panel-glow"></div>
    <div class="location-inner">
      <div class="location-toolbar">
        <button id="location-bar-toggle" class="dock-tray-toggle" type="button" data-dock-toggle-target="location-bar" aria-controls="location-bar-popover" aria-expanded="false" aria-label="KONUM Panelini Aç" title="KONUM Panelini Aç">
          <span class="location-toolbar-label"><span class="dock-label-icon dock-label-icon-location" aria-hidden="true"></span>KONUM</span>
        </button>
        <button class="panel-collapse-btn" data-collapse-target="location-bar" title="Paneli küçült">+</button>
      </div>
      <div id="location-mini-status" class="location-mini-status" aria-live="polite">
        <div id="location-mini-city" class="location-mini-city">📍 Konum: --</div>
        <div id="location-mini-poi" class="location-mini-poi">Nokta: --</div>
      </div>
      <div id="location-bar-popover" class="dock-popover-content">
        <button class="dock-pin-btn" data-pin-target="location-bar" type="button" aria-label="Konum panelini sabitle" aria-pressed="false" title="Konum panelini açık tut"><img src="/pin.svg" alt="" /></button>
        <div id="poi-row" class="poi-row-container"></div>
        <div class="location-bar-divider" id="location-bar-divider"></div>
        <div class="location-city-row">
          <div id="location-pills" class="location-pills"></div>
          <div class="location-search-wrap">
            <button id="search-toggle" class="search-toggle-btn" title="Konum veya koordinat ara">
              <span>&#x1F50E;</span>
            </button>
            <input type="text" id="location-search" placeholder="Konum veya koordinat ara..." autocomplete="off" spellcheck="false" aria-label="İsim veya koordinat ile konum arama" />
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>