{
  "rewrites": [
    {
      "source": "/api/proxy/adsb-mil",
      "destination": "https://opendata.adsb.fi/api/v2/mil"
    },
    {
      "source": "/api/proxy/adsb-live/:path*",
      "destination": "https://opendata.adsb.fi/api/v2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}